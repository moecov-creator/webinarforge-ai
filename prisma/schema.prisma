generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webinars  Webinar[]
  analytics AnalyticsEvent[]
}

model Webinar {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  status        String    @default("DRAFT")
  registrations Int       @default(0)
  clicks        Int       @default(0)
  script        String?   @db.Text
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  analyticsEvents AnalyticsEvent[]
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  webinarId String?
  webinar   Webinar? @relation(fields: [webinarId], references: [id])
}

model AssetFactoryProject {
  id             String               @id @default(cuid())
  userId         String
  title          String
  niche          String
  targetAudience String
  desiredOutcome String
  offerType      String
  tone           String
  cta            String
  industry       String
  pricePoint     String
  status         String               @default("pending")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  outputs        AssetFactoryOutput[]

  @@index([userId])
}

model AssetFactoryOutput {
  id           String              @id @default(cuid())
  projectId    String
  phase        String
  sectionTitle String
  content      String              @db.Text
  format       String              @default("text")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  project      AssetFactoryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
